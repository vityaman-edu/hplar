name:           hplar
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/vityaman-edu/hplar#readme>
homepage:       https://github.com/vityaman-edu/hplar#readme
bug-reports:    https://github.com/vityaman-edu/hplar/issues
author:         Victor Smirmov
maintainer:     vityaman.dev@yandex.ru
copyright:      2026 Victor Smirmov
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md

source-repository head
  type: git
  location: https://github.com/vityaman-edu/hplar

library
  exposed-modules:
      DPLL
      Formula
      Lib
      PropCNF
      PropFormula
  other-modules:
      Paths_hplar
  autogen-modules:
      Paths_hplar
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
  default-language: Haskell2010

executable hplar-exe
  main-is: Main.hs
  other-modules:
      Paths_hplar
  autogen-modules:
      Paths_hplar
  hs-source-dirs:
      app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , hplar
  default-language: Haskell2010

test-suite hplar-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      PropCNFSpec
      PropFormulaSpec
      Paths_hplar
  autogen-modules:
      Paths_hplar
  hs-source-dirs:
      test
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , hplar
    , hspec
  default-language: Haskell2010
